# Vidudhi Hostel Resident Portal Backend Configuration
# Database Cluster: keerthana
PORT=5000
NODE_ENV=development

# MongoDB Connection String:
# Uses local running MongoDB by default with database name 'keerthana'.
# To connect to MongoDB Atlas cluster 'keerthana', replace with your Atlas connection string:
MONGODB_URI=mongodb+srv://keerthana:keer@cluster0.92rctps.mongodb.net/vidudhi?retryWrites=true&w=majority
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/keerthana

# JWT & Cryptographic Security
JWT_SECRET=vidudhi_keerthana_portal_jwt_secret_token_2026_xyz
JWT_EXPIRES_IN=7d
AUDIT_HMAC_SECRET=vidudhi_keerthana_audit_hmac_secret_key_9981

# Google OAuth Client ID (Registered on Google Cloud Console)
GOOGLE_CLIENT_ID=953880868649-mopb50m92ocgpvm512va4kecm4slo96b.apps.googleusercontent.com

# Non-CRUD Geofence Parameters (Vidudhi Campus, Chennai Coordinates)
HOSTEL_LAT=13.0827
HOSTEL_LNG=80.2707
GEOFENCE_RADIUS_METERS=300

# Optional Gemini API key for Chatbot
# GEMINI_API_KEY=your_gemini_api_key_here
